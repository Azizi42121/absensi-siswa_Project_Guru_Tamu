<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-8 space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Verifikasi Surat Bukti Sakit / Izin Siswa</h1>
        <p class="text-xs text-slate-500 mt-1">Tinjau dan verifikasi keabsahan dokumen/surat dokter yang diunggah oleh siswa</p>
      </div>
    </div>

    <!-- Notes Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-100 font-bold text-slate-800">
        Daftar Pengajuan Surat Sakit / Izin (<%= notes.length %> Dokumen)
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-xs uppercase text-slate-400 font-semibold border-b border-slate-100">
            <tr>
              <th class="px-6 py-3.5">Tanggal Presensi</th>
              <th class="px-6 py-3.5">Nama Siswa</th>
              <th class="px-6 py-3.5">Kelas & Mapel</th>
              <th class="px-6 py-3.5">Status & Dokumen Surat</th>
              <th class="px-6 py-3.5">Keterangan</th>
              <th class="px-6 py-3.5 text-center">Status Verifikasi</th>
              <th class="px-6 py-3.5 text-right">Aksi Verifikasi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (notes.length === 0) { %>
            <tr><td colspan="7" class="px-6 py-8 text-center text-xs text-slate-400">Tidak ada pengajuan surat sakit/izin yang membutuhkan verifikasi.</td></tr>
            <% } %>
            <% notes.forEach(n => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-6 py-4 whitespace-nowrap text-xs font-semibold text-slate-700">
                <%= new Date(n.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap font-bold text-slate-800">
                <%= n.student.nama %>
                <div class="text-[11px] font-normal text-slate-400">NISN: <%= n.student.nisn || '-' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="font-semibold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded text-xs"><%= n.schedule.class.namaKelas %></span>
                <div class="text-xs text-slate-500 mt-1"><%= n.schedule.subject.namaMapel %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= n.status === 'SAKIT' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= n.status %>
                </span>
                <div class="mt-1">
                  <a href="<%= n.suratBuktiUrl %>" target="_blank" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 text-xs font-semibold underline">
                    <i class="fa-solid fa-file-pdf mr-1 text-rose-500"></i> Buka File Surat
                  </a>
                </div>
              </td>
              <td class="px-6 py-4 text-xs text-slate-600 max-w-xs">
                <%= n.keterangan || '-' %>
              </td>
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <% if (n.verifiedByTeacher) { %>
                  <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">
                    <i class="fa-solid fa-circle-check text-[10px] mr-1"></i> Disetujui
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold">
                    <i class="fa-solid fa-clock text-[10px] mr-1"></i> Menunggu Verifikasi
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-right whitespace-nowrap">
                <form action="/guru/verify-notes" method="POST" class="inline-flex items-center space-x-2">
                  <input type="hidden" name="attendanceId" value="<%= n.id %>">
                  <button type="submit" name="statusAction" value="APPROVE" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-lg transition shadow-xs">
                    <i class="fa-solid fa-check mr-1"></i> Setujui
                  </button>
                  <button type="submit" name="statusAction" value="REJECT" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs rounded-lg transition shadow-xs" onclick="return confirm('Tolak surat dan ubah status menjadi ALPA?');">
                    <i class="fa-solid fa-xmark mr-1"></i> Tolak
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
