<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex flex-col lg:flex-row">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6 sm:space-y-8 max-w-full overflow-hidden">
    <!-- Header Guru Banner -->
    <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-indigo-950 rounded-3xl p-6 sm:p-8 text-white shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-6 hover-lift">
      <div class="space-y-2">
        <div class="inline-flex items-center px-3 py-1 bg-indigo-800/80 rounded-full text-xs font-bold text-indigo-200 border border-indigo-700/50">
          <i class="fa-solid fa-graduation-cap mr-1.5 text-indigo-400"></i> Portal Guru & Wali Kelas
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Selamat Datang, <%= user.nama %></h1>
        <p class="text-xs sm:text-sm text-indigo-200/90 leading-relaxed">Silakan pilih jadwal kelas di bawah ini untuk menginput presensi siswa dan mencatat jurnal mengajar.</p>
      </div>

      <% if (pendingNotesCount > 0) { %>
      <a href="/guru/verify-notes" class="bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-5 py-3.5 rounded-2xl shadow-md text-xs font-bold flex items-center space-x-3 transition transform hover:scale-105 active:scale-95">
        <i class="fa-solid fa-triangle-exclamation text-xl animate-bounce"></i>
        <span><%= pendingNotesCount %> Surat Dokter/Izin Butuh Verifikasi!</span>
      </a>
      <% } %>
    </div>

    <!-- Section 1: Assigned Schedules -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-extrabold text-slate-900 tracking-tight">Jadwal Pelajaran Anda</h2>
        <span class="text-xs text-slate-500 font-bold bg-slate-100 px-3 py-1 rounded-full border border-slate-200"><%= schedules.length %> Jadwal Teralokasi</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% if (schedules.length === 0) { %>
        <div class="col-span-full bg-white p-8 rounded-2xl border border-slate-200/80 text-center text-slate-400 text-sm">
          Belum ada jadwal mengajar yang dialokasikan oleh Admin.
        </div>
        <% } %>
        <% schedules.forEach(s => { %>
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 sm:p-6 shadow-xs hover-lift flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 bg-indigo-50 text-indigo-700 font-bold text-xs rounded-xl border border-indigo-200/60">
                <i class="fa-solid fa-calendar-day mr-1"></i> <%= s.hari %>
              </span>
              <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded-lg"><%= s.jamKe %></span>
            </div>
            <h3 class="font-extrabold text-slate-900 text-lg mb-1"><%= s.class.namaKelas %></h3>
            <p class="text-xs font-semibold text-slate-600"><%= s.subject.namaMapel %></p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
            <a href="/guru/attendance/<%= s.id %>" class="w-full text-center py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center space-x-1.5">
              <i class="fa-solid fa-clipboard-user text-sm"></i>
              <span>Input Presensi & Jurnal</span>
            </a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Section 2: Recent Journals -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
      <div class="p-5 border-b border-slate-100 font-bold text-slate-900 flex items-center justify-between">
        <span>Riwayat Jurnal Mengajar Terbaru Anda</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-xs uppercase text-slate-400 font-bold border-b border-slate-100">
            <tr>
              <th class="px-6 py-3.5 whitespace-nowrap">Tanggal</th>
              <th class="px-6 py-3.5 whitespace-nowrap">Kelas & Mapel</th>
              <th class="px-6 py-3.5 whitespace-nowrap">Materi Pelajaran</th>
              <th class="px-6 py-3.5 whitespace-nowrap">Catatan Agenda Kelas</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (recentJournals.length === 0) { %>
            <tr><td colspan="4" class="px-6 py-6 text-center text-xs text-slate-400">Belum ada jurnal materi yang pernah dibuat.</td></tr>
            <% } %>
            <% recentJournals.forEach(j => { %>
            <tr class="hover:bg-slate-50/80 transition">
              <td class="px-6 py-4 whitespace-nowrap text-xs font-semibold text-slate-700">
                <%= new Date(j.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="font-bold text-slate-900 mr-2"><%= j.schedule.class.namaKelas %></span>
                <span class="text-xs text-slate-500 font-medium"><%= j.schedule.subject.namaMapel %></span>
              </td>
              <td class="px-6 py-4 font-semibold text-slate-800"><%= j.materiAjar %></td>
              <td class="px-6 py-4 text-xs text-slate-500 font-medium"><%= j.catatanKelas || '-' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
