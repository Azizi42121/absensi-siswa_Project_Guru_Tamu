<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-8 space-y-8">
    <!-- Header Guru -->
    <div class="bg-gradient-to-r from-indigo-900 to-indigo-700 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="inline-flex items-center px-3 py-1 bg-indigo-800/60 rounded-full text-xs font-semibold text-indigo-200">
          <i class="fa-solid fa-graduation-cap mr-1.5"></i> Portal Guru & Wali Kelas
        </div>
        <h1 class="text-2xl font-bold">Selamat Datang, <%= user.nama %></h1>
        <p class="text-xs text-indigo-200">Silakan pilih jadwal kelas di bawah ini untuk menginput presensi siswa dan mencatat jurnal mengajar.</p>
      </div>

      <% if (pendingNotesCount > 0) { %>
      <a href="/guru/verify-notes" class="bg-amber-500 hover:bg-amber-600 text-white px-4 py-3 rounded-xl shadow-md text-xs font-bold flex items-center space-x-2 transition transform hover:scale-105">
        <i class="fa-solid fa-triangle-exclamation text-lg"></i>
        <span><%= pendingNotesCount %> Surat Dokter/Izin Butuh Verifikasi!</span>
      </a>
      <% } %>
    </div>

    <!-- Section 1: Assigned Schedules -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-800">Jadwal Pelajaran Anda</h2>
        <span class="text-xs text-slate-500 font-medium"><%= schedules.length %> Jadwal Teralokasi</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (schedules.length === 0) { %>
        <div class="col-span-full bg-white p-8 rounded-2xl border border-slate-200 text-center text-slate-400 text-sm">
          Belum ada jadwal mengajar yang dialokasikan oleh Admin.
        </div>
        <% } %>
        <% schedules.forEach(s => { %>
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 bg-indigo-50 text-indigo-700 font-bold text-xs rounded-lg">
                <%= s.hari %>
              </span>
              <span class="text-xs text-slate-400 font-mono"><%= s.jamKe %></span>
            </div>
            <h3 class="font-bold text-slate-800 text-base mb-1"><%= s.class.namaKelas %></h3>
            <p class="text-xs font-medium text-slate-600"><%= s.subject.namaMapel %></p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
            <a href="/guru/attendance/<%= s.id %>" class="w-full text-center py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl transition shadow-xs">
              <i class="fa-solid fa-clipboard-user mr-1.5"></i> Input Presensi & Jurnal
            </a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Section 2: Recent Journals -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-100 font-bold text-slate-800">
        Riwayat Jurnal Mengajar Terbaru Anda
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-xs uppercase text-slate-400 font-semibold border-b border-slate-100">
            <tr>
              <th class="px-6 py-3">Tanggal</th>
              <th class="px-6 py-3">Kelas & Mapel</th>
              <th class="px-6 py-3">Materi Pelajaran</th>
              <th class="px-6 py-3">Catatan Agenda Kelas</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (recentJournals.length === 0) { %>
            <tr><td colspan="4" class="px-6 py-6 text-center text-xs text-slate-400">Belum ada jurnal materi yang pernah dibuat.</td></tr>
            <% } %>
            <% recentJournals.forEach(j => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-6 py-3.5 whitespace-nowrap text-xs font-semibold text-slate-700">
                <%= new Date(j.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-3.5 whitespace-nowrap">
                <span class="font-bold text-slate-800 mr-2"><%= j.schedule.class.namaKelas %></span>
                <span class="text-xs text-slate-500"><%= j.schedule.subject.namaMapel %></span>
              </td>
              <td class="px-6 py-3.5 font-medium text-slate-800"><%= j.materiAjar %></td>
              <td class="px-6 py-3.5 text-xs text-slate-500"><%= j.catatanKelas || '-' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
