<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex flex-col lg:flex-row">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6 sm:space-y-8 max-w-full overflow-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
      <div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">Rekapitulasi Kehadiran Pribadi</h1>
        <p class="text-xs text-slate-500 mt-1">Daftar lengkap seluruh rekam presensi Anda di semua mata pelajaran</p>
      </div>
      <a href="/siswa/upload-note" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition shadow-md w-fit">
        <i class="fa-solid fa-cloud-arrow-up mr-1.5"></i> Upload Surat Dokter/Izin
      </a>
    </div>

    <!-- Summary Stats Box -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4">
      <div class="bg-white p-4 rounded-2xl border border-slate-200/80 text-center shadow-xs hover-lift">
        <span class="text-[11px] text-slate-400 font-bold uppercase block">Total Pertemuan</span>
        <span class="text-lg sm:text-xl font-extrabold text-slate-900 mt-1 block"><%= stats.total %> Sesi</span>
      </div>
      <div class="bg-emerald-50/80 p-4 rounded-2xl border border-emerald-200/80 text-center hover-lift">
        <span class="text-[11px] text-emerald-600 font-bold uppercase block">Hadir</span>
        <span class="text-lg sm:text-xl font-extrabold text-emerald-800 mt-1 block"><%= stats.hadir %></span>
      </div>
      <div class="bg-amber-50/80 p-4 rounded-2xl border border-amber-200/80 text-center hover-lift">
        <span class="text-[11px] text-amber-600 font-bold uppercase block">Sakit</span>
        <span class="text-lg sm:text-xl font-extrabold text-amber-800 mt-1 block"><%= stats.sakit %></span>
      </div>
      <div class="bg-blue-50/80 p-4 rounded-2xl border border-blue-200/80 text-center hover-lift">
        <span class="text-[11px] text-blue-600 font-bold uppercase block">Izin</span>
        <span class="text-lg sm:text-xl font-extrabold text-blue-800 mt-1 block"><%= stats.izin %></span>
      </div>
      <div class="bg-rose-50/80 p-4 rounded-2xl border border-rose-200/80 text-center hover-lift col-span-2 sm:col-span-1">
        <span class="text-[11px] text-rose-600 font-bold uppercase block">Alpa</span>
        <span class="text-lg sm:text-xl font-extrabold text-rose-800 mt-1 block"><%= stats.alpa %></span>
      </div>
    </div>

    <!-- Attendance Table -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
      <div class="p-5 border-b border-slate-100 font-bold text-slate-900">
        Riwayat Detail Presensi
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-xs uppercase text-slate-400 font-bold border-b border-slate-100">
            <tr>
              <th class="px-6 py-3.5 whitespace-nowrap">Tanggal</th>
              <th class="px-6 py-3.5 whitespace-nowrap">Mata Pelajaran</th>
              <th class="px-6 py-3.5 whitespace-nowrap">Guru Mapel</th>
              <th class="px-6 py-3.5 text-center whitespace-nowrap">Status</th>
              <th class="px-6 py-3.5 whitespace-nowrap">Lampiran Surat Bukti</th>
              <th class="px-6 py-3.5 text-center whitespace-nowrap">Verifikasi Guru</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (attendances.length === 0) { %>
            <tr><td colspan="6" class="px-6 py-8 text-center text-xs text-slate-400">Belum ada riwayat presensi tercatat.</td></tr>
            <% } %>
            <% attendances.forEach(att => { %>
            <tr class="hover:bg-slate-50/80 transition">
              <td class="px-6 py-4 whitespace-nowrap text-xs font-bold text-slate-700">
                <%= new Date(att.tanggal).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4 font-bold text-slate-900 whitespace-nowrap">
                <%= att.schedule.subject.namaMapel %>
              </td>
              <td class="px-6 py-4 text-xs font-medium text-slate-600 whitespace-nowrap">
                <%= att.schedule.teacher.nama %>
              </td>
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <% if (att.status === 'HADIR') { %>
                  <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">Hadir</span>
                <% } else if (att.status === 'SAKIT') { %>
                  <span class="px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold">Sakit</span>
                <% } else if (att.status === 'IZIN') { %>
                  <span class="px-2.5 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-bold">Izin</span>
                <% } else { %>
                  <span class="px-2.5 py-1 bg-rose-100 text-rose-800 rounded-full text-xs font-bold">Alpa</span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-xs whitespace-nowrap">
                <% if (att.suratBuktiUrl) { %>
                  <a href="<%= att.suratBuktiUrl %>" target="_blank" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 font-bold underline">
                    <i class="fa-solid fa-paperclip mr-1 text-indigo-500"></i> Buka Dokumen
                  </a>
                <% } else { %>
                  <span class="text-slate-400 italic">Tidak ada lampiran</span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <% if (att.verifiedByTeacher) { %>
                  <span class="inline-flex items-center text-xs font-bold text-emerald-600">
                    <i class="fa-solid fa-circle-check text-emerald-500 mr-1"></i> Terverifikasi
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center text-xs font-bold text-amber-600">
                    <i class="fa-solid fa-clock text-amber-500 mr-1"></i> Menunggu
                  </span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
