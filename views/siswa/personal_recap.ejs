<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-8 space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Rekapitulasi Kehadiran Pribadi</h1>
        <p class="text-xs text-slate-500 mt-1">Daftar lengkap seluruh rekam presensi Anda di semua mata pelajaran</p>
      </div>
      <a href="/siswa/upload-note" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl transition">
        <i class="fa-solid fa-cloud-arrow-up mr-1"></i> Upload Surat Dokter/Izin
      </a>
    </div>

    <!-- Summary Stats Box -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
      <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
        <span class="text-xs text-slate-400 font-semibold uppercase block">Total Pertemuan</span>
        <span class="text-xl font-bold text-slate-800 mt-1 block"><%= stats.total %> Sesi</span>
      </div>
      <div class="bg-emerald-50 p-4 rounded-xl border border-emerald-200 text-center">
        <span class="text-xs text-emerald-600 font-semibold uppercase block">Hadir</span>
        <span class="text-xl font-bold text-emerald-800 mt-1 block"><%= stats.hadir %></span>
      </div>
      <div class="bg-amber-50 p-4 rounded-xl border border-amber-200 text-center">
        <span class="text-xs text-amber-600 font-semibold uppercase block">Sakit</span>
        <span class="text-xl font-bold text-amber-800 mt-1 block"><%= stats.sakit %></span>
      </div>
      <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 text-center">
        <span class="text-xs text-blue-600 font-semibold uppercase block">Izin</span>
        <span class="text-xl font-bold text-blue-800 mt-1 block"><%= stats.izin %></span>
      </div>
      <div class="bg-rose-50 p-4 rounded-xl border border-rose-200 text-center">
        <span class="text-xs text-rose-600 font-semibold uppercase block">Alpa</span>
        <span class="text-xl font-bold text-rose-800 mt-1 block"><%= stats.alpa %></span>
      </div>
    </div>

    <!-- Attendance Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-100 font-bold text-slate-800">
        Riwayat Detail Presensi
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-xs uppercase text-slate-400 font-semibold border-b border-slate-100">
            <tr>
              <th class="px-6 py-3.5">Tanggal</th>
              <th class="px-6 py-3.5">Mata Pelajaran</th>
              <th class="px-6 py-3.5">Guru Mapel</th>
              <th class="px-6 py-3.5 text-center">Status</th>
              <th class="px-6 py-3.5">Lampiran Surat Bukti</th>
              <th class="px-6 py-3.5 text-center">Verifikasi Guru</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (attendances.length === 0) { %>
            <tr><td colspan="6" class="px-6 py-8 text-center text-xs text-slate-400">Belum ada riwayat presensi tercatat.</td></tr>
            <% } %>
            <% attendances.forEach(att => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-6 py-4 whitespace-nowrap text-xs font-semibold text-slate-700">
                <%= new Date(att.tanggal).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4 font-bold text-slate-800 whitespace-nowrap">
                <%= att.schedule.subject.namaMapel %>
              </td>
              <td class="px-6 py-4 text-xs text-slate-600 whitespace-nowrap">
                <%= att.schedule.teacher.nama %>
              </td>
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <% if (att.status === 'HADIR') { %>
                  <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">Hadir</span>
                <% } else if (att.status === 'SAKIT') { %>
                  <span class="px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold">Sakit</span>
                <% } else if (att.status === 'IZIN') { %>
                  <span class="px-2.5 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-bold">Izin</span>
                <% } else { %>
                  <span class="px-2.5 py-1 bg-rose-100 text-rose-800 rounded-full text-xs font-bold">Alpa</span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-xs whitespace-nowrap">
                <% if (att.suratBuktiUrl) { %>
                  <a href="<%= att.suratBuktiUrl %>" target="_blank" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 font-semibold underline">
                    <i class="fa-solid fa-paperclip mr-1"></i> Buka Dokumen
                  </a>
                <% } else { %>
                  <span class="text-slate-400 italic">Tidak ada lampiran</span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <% if (att.verifiedByTeacher) { %>
                  <span class="inline-flex items-center text-xs font-semibold text-emerald-600">
                    <i class="fa-solid fa-circle-check text-emerald-500 mr-1"></i> Terverifikasi
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center text-xs font-semibold text-amber-600">
                    <i class="fa-solid fa-clock text-amber-500 mr-1"></i> Menunggu
                  </span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
