<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-8 space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Manajemen Data Mata Pelajaran</h1>
        <p class="text-xs text-slate-500 mt-1">Kelola daftar kurikulum mata pelajaran sekolah</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Form Create Subject -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-fit">
        <h2 class="text-base font-bold text-slate-800 mb-4 flex items-center">
          <i class="fa-solid fa-plus-circle text-indigo-600 mr-2"></i> Tambah Mapel Baru
        </h2>
        <form action="/admin/subjects" method="POST" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Kode Mapel</label>
            <input type="text" name="kodeMapel" placeholder="misal: PWPB-01" required
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nama Mata Pelajaran</label>
            <input type="text" name="namaMapel" placeholder="misal: Pemrograman Web" required
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <button type="submit" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl transition">
            Simpan Mapel
          </button>
        </form>
      </div>

      <!-- Subject Table -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 font-bold text-slate-800">
          Daftar Mata Pelajaran (<%= subjects.length %>)
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-xs uppercase text-slate-400 font-semibold border-b border-slate-100">
              <tr>
                <th class="px-6 py-3">Kode Mapel</th>
                <th class="px-6 py-3">Nama Mata Pelajaran</th>
                <th class="px-6 py-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (subjects.length === 0) { %>
              <tr><td colspan="3" class="px-6 py-6 text-center text-xs text-slate-400">Belum ada data mata pelajaran.</td></tr>
              <% } %>
              <% subjects.forEach(s => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-3.5 font-mono text-xs font-bold text-indigo-600"><%= s.kodeMapel %></td>
                <td class="px-6 py-3.5 font-semibold text-slate-800"><%= s.namaMapel %></td>
                <td class="px-6 py-3.5 text-right">
                  <form action="/admin/subjects/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Hapus mata pelajaran ini?');">
                    <button type="submit" class="text-rose-600 hover:text-rose-800 font-medium text-xs">
                      <i class="fa-solid fa-trash mr-1"></i> Hapus
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
