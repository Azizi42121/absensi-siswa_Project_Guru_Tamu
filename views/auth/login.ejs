<%- include('../partials/header') %>

<main class="min-h-screen flex items-center justify-center p-4 sm:p-6 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white relative overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-600/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-600/30 rounded-full blur-3xl pointer-events-none"></div>

  <div class="w-full max-w-md bg-white/10 backdrop-blur-2xl border border-white/20 p-6 sm:p-8 rounded-3xl shadow-2xl z-10 hover-lift">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-tr from-indigo-500 to-violet-600 rounded-2xl mb-3 shadow-lg shadow-indigo-500/30">
        <i class="fa-solid fa-graduation-cap text-3xl text-white"></i>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">PresensiEdu</h1>
      <p class="text-xs sm:text-sm text-indigo-200 mt-1">Sistem Absensi Siswa & Jurnal Mengajar Guru</p>
    </div>

    <% if (error) { %>
    <div class="mb-6 p-4 bg-rose-500/20 border border-rose-500/40 text-rose-200 text-xs rounded-2xl flex items-center space-x-3">
      <i class="fa-solid fa-circle-exclamation text-lg text-rose-400"></i>
      <span class="font-medium"><%= error %></span>
    </div>
    <% } %>

    <!-- Login Form -->
    <form action="/auth/login" method="POST" class="space-y-5">
      <div>
        <label for="username" class="block text-xs font-bold uppercase tracking-wider text-indigo-200 mb-2">Username</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-indigo-300/70">
            <i class="fa-solid fa-user text-sm"></i>
          </div>
          <input type="text" id="username" name="username" required
            class="w-full pl-11 pr-4 py-3 bg-white/10 border border-white/15 rounded-xl text-white placeholder-indigo-200/50 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
            placeholder="Masukkan username anda">
        </div>
      </div>

      <div>
        <label for="password" class="block text-xs font-bold uppercase tracking-wider text-indigo-200 mb-2">Password</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-indigo-300/70">
            <i class="fa-solid fa-lock text-sm"></i>
          </div>
          <input type="password" id="password" name="password" required
            class="w-full pl-11 pr-4 py-3 bg-white/10 border border-white/15 rounded-xl text-white placeholder-indigo-200/50 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
            placeholder="••••••••">
        </div>
      </div>

      <button type="submit"
        class="w-full py-3.5 bg-gradient-to-r from-indigo-500 via-indigo-600 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-bold rounded-xl text-sm shadow-glow-indigo transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0">
        <i class="fa-solid fa-right-to-bracket mr-2"></i> Masuk Sistem
      </button>
    </form>

    <!-- Quick Demo Switcher -->
    <div class="mt-8 pt-6 border-t border-white/10 text-center">
      <p class="text-xs font-bold text-indigo-200 uppercase tracking-wider mb-3">⚡ Quick Demo Switcher (1-Click Login)</p>
      <div class="grid grid-cols-3 gap-2">
        <button type="button" onclick="fillDemo('admin')"
          class="px-2 py-2.5 bg-purple-500/20 hover:bg-purple-500/30 border border-purple-400/30 rounded-xl text-xs font-bold text-purple-200 transition flex flex-col items-center justify-center">
          <i class="fa-solid fa-user-shield text-base text-purple-300 mb-1"></i> Admin
        </button>
        <button type="button" onclick="fillDemo('gurumapel')"
          class="px-2 py-2.5 bg-blue-500/20 hover:bg-blue-500/30 border border-blue-400/30 rounded-xl text-xs font-bold text-blue-200 transition flex flex-col items-center justify-center">
          <i class="fa-solid fa-chalkboard-user text-base text-blue-300 mb-1"></i> Guru Mapel
        </button>
        <button type="button" onclick="fillDemo('siswa')"
          class="px-2 py-2.5 bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/30 rounded-xl text-xs font-bold text-emerald-200 transition flex flex-col items-center justify-center">
          <i class="fa-solid fa-user-graduate text-base text-emerald-300 mb-1"></i> Siswa
        </button>
      </div>
    </div>
  </div>
</main>

<script>
  function fillDemo(role) {
    document.getElementById('username').value = role;
    document.getElementById('password').value = 'password123';
  }
</script>

</body>
</html>
