<%- include('../partials/header') %>

<main class="min-h-screen flex items-center justify-center p-6 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white relative overflow-hidden">
  <!-- Background Glow FX -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>

  <div class="w-full max-w-md bg-white/10 backdrop-blur-xl border border-white/20 p-8 rounded-2xl shadow-2xl z-10">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-tr from-indigo-500 to-purple-600 rounded-2xl mb-3 shadow-lg shadow-indigo-500/30">
        <i class="fa-solid fa-graduation-cap text-3xl text-white"></i>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-white">PresensiEdu</h1>
      <p class="text-xs text-indigo-200 mt-1">Sistem Absensi Siswa & Jurnal Mengajar Guru</p>
    </div>

    <% if (error) { %>
    <div class="mb-6 p-3.5 bg-rose-500/20 border border-rose-500/40 text-rose-200 text-xs rounded-xl flex items-center space-x-2">
      <i class="fa-solid fa-circle-exclamation text-base"></i>
      <span><%= error %></span>
    </div>
    <% } %>

    <!-- Login Form -->
    <form action="/auth/login" method="POST" class="space-y-5">
      <div>
        <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-indigo-200 mb-1.5">Username</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i class="fa-solid fa-user text-sm"></i>
          </div>
          <input type="text" id="username" name="username" required
            class="w-full pl-10 pr-4 py-2.5 bg-white/5 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
            placeholder="Masukkan username anda">
        </div>
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-indigo-200 mb-1.5">Password</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i class="fa-solid fa-lock text-sm"></i>
          </div>
          <input type="password" id="password" name="password" required
            class="w-full pl-10 pr-4 py-2.5 bg-white/5 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
            placeholder="••••••••">
        </div>
      </div>

      <button type="submit"
        class="w-full py-3 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold rounded-xl text-sm shadow-lg shadow-indigo-500/25 transition-all duration-200 transform hover:-translate-y-0.5">
        <i class="fa-solid fa-right-to-bracket mr-2"></i> Masuk Sistem
      </button>
    </form>

    <!-- Quick Demo Switcher -->
    <div class="mt-8 pt-6 border-t border-white/10 text-center">
      <p class="text-xs font-semibold text-indigo-200 uppercase tracking-wider mb-3">⚡ Quick Demo Switcher (1-Click Login)</p>
      <div class="grid grid-cols-3 gap-2">
        <button type="button" onclick="fillDemo('admin')"
          class="px-2.5 py-2 bg-purple-500/20 hover:bg-purple-500/30 border border-purple-400/30 rounded-lg text-xs font-semibold text-purple-200 transition">
          <i class="fa-solid fa-user-shield block mb-1 text-sm text-purple-300"></i> Admin
        </button>
        <button type="button" onclick="fillDemo('gurumapel')"
          class="px-2.5 py-2 bg-blue-500/20 hover:bg-blue-500/30 border border-blue-400/30 rounded-lg text-xs font-semibold text-blue-200 transition">
          <i class="fa-solid fa-chalkboard-user block mb-1 text-sm text-blue-300"></i> Guru Mapel
        </button>
        <button type="button" onclick="fillDemo('siswa')"
          class="px-2.5 py-2 bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/30 rounded-lg text-xs font-semibold text-emerald-200 transition">
          <i class="fa-solid fa-user-graduate block mb-1 text-sm text-emerald-300"></i> Siswa
        </button>
      </div>
    </div>
  </div>
</main>

<script>
  function fillDemo(role) {
    document.getElementById('username').value = role;
    document.getElementById('password').value = 'password123';
  }
</script>

</body>
</html>
