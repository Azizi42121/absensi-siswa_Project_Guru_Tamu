<header class="no-print bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-30 shadow-xs">
  <div class="px-4 sm:px-6 py-3 flex items-center justify-between">
    <!-- Left Section: Logo & Mobile Toggle Button -->
    <div class="flex items-center space-x-3">
      <!-- Mobile Sidebar Toggle Button -->
      <% if (user) { %>
      <button id="sidebar-toggle" type="button" class="lg:hidden p-2 text-slate-600 hover:text-indigo-600 hover:bg-slate-100 rounded-xl transition-colors focus:outline-none" aria-label="Buka Menu Navigation">
        <i class="fa-solid fa-bars-staggered text-xl"></i>
      </button>
      <% } %>

      <a href="/" class="flex items-center space-x-3 group">
        <div class="bg-gradient-to-tr from-indigo-600 to-violet-600 text-white p-2.5 rounded-xl shadow-md group-hover:scale-105 transition-transform flex items-center justify-center">
          <i class="fa-solid fa-clipboard-user text-lg"></i>
        </div>
        <div>
          <h1 class="font-extrabold text-slate-900 text-lg tracking-tight leading-tight flex items-center gap-1.5">
            PresensiEdu
            <span class="hidden xs:inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-indigo-50 text-indigo-700 rounded-full border border-indigo-200/60">v1.0</span>
          </h1>
          <p class="text-[11px] text-slate-500 font-medium hidden sm:block">Sistem Absensi & Jurnal Mengajar Real-time</p>
        </div>
      </a>
    </div>

    <!-- Right Section: User Info & Actions -->
    <% if (user) { %>
    <div class="flex items-center space-x-3 sm:space-x-4">
      <div class="text-right hidden md:block">
        <div class="font-bold text-slate-800 text-sm leading-snug"><%= user.nama %></div>
        <div class="text-xs font-semibold mt-0.5">
          <% if (user.role === 'ADMIN') { %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-purple-100/80 text-purple-700 border border-purple-200">
              <i class="fa-solid fa-user-shield mr-1 text-[10px]"></i> Admin Kurikulum / IT
            </span>
          <% } else if (user.role === 'GURU_MAPEL') { %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-100/80 text-blue-700 border border-blue-200">
              <i class="fa-solid fa-chalkboard-user mr-1 text-[10px]"></i> Guru Mapel
            </span>
          <% } else { %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100/80 text-emerald-700 border border-emerald-200">
              <i class="fa-solid fa-user-graduate mr-1 text-[10px]"></i> Siswa (<%= user.namaKelas || 'Siswa' %>)
            </span>
          <% } %>
        </div>
      </div>

      <!-- Logout Button -->
      <a href="/auth/logout" class="inline-flex items-center px-3.5 py-2 text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100/80 rounded-xl transition-all duration-200 border border-rose-200/80 hover:shadow-sm">
        <i class="fa-solid fa-right-from-bracket mr-1.5"></i>
        <span>Logout</span>
      </a>
    </div>
    <% } %>
  </div>
</header>
