<header class="no-print bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
  <div class="px-6 py-3.5 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md flex items-center justify-center">
        <i class="fa-solid fa-clipboard-user text-lg"></i>
      </div>
      <div>
        <h1 class="font-bold text-slate-800 text-lg leading-tight">PresensiEdu</h1>
        <p class="text-xs text-slate-500">Sistem Manajemen Absensi & Jurnal Mengajar</p>
      </div>
    </div>

    <% if (user) { %>
    <div class="flex items-center space-x-4">
      <div class="text-right hidden sm:block">
        <div class="font-semibold text-slate-800 text-sm"><%= user.nama %></div>
        <div class="text-xs font-medium">
          <% if (user.role === 'ADMIN') { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">
              <i class="fa-solid fa-user-shield mr-1 text-[10px]"></i> Admin Kurikulum / IT
            </span>
          <% } else if (user.role === 'GURU_MAPEL') { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">
              <i class="fa-solid fa-chalkboard-user mr-1 text-[10px]"></i> Guru Mapel / Wali Kelas
            </span>
          <% } else { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
              <i class="fa-solid fa-user-graduate mr-1 text-[10px]"></i> Siswa (<%= user.namaKelas || 'Siswa' %>)
            </span>
          <% } %>
        </div>
      </div>
      <a href="/auth/logout" class="inline-flex items-center px-3.5 py-2 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-lg transition-colors border border-rose-200">
        <i class="fa-solid fa-right-from-bracket mr-1.5"></i> Logout
      </a>
    </div>
    <% } %>
  </div>
</header>
