<!-- Backdrop Overlay for Mobile Navigation Drawer -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity duration-300"></div>

<!-- Sidebar Drawer Container -->
<aside id="sidebar-drawer" class="no-print fixed lg:static inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200/80 flex-shrink-0 min-h-[calc(100vh-61px)] p-4 flex flex-col justify-between transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-xl lg:shadow-none">
  <div class="space-y-6">

    <!-- Mobile Drawer Header -->
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 lg:hidden">
      <div class="flex items-center space-x-2">
        <div class="bg-indigo-600 text-white p-1.5 rounded-lg text-xs">
          <i class="fa-solid fa-compass"></i>
        </div>
        <span class="font-bold text-slate-800 text-sm">Navigasi Utama</span>
      </div>
      <button id="sidebar-close" type="button" class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <% const path = typeof currentPath !== 'undefined' ? currentPath : ''; %>

    <% if (user && user.role === 'ADMIN') { %>
    <div>
      <div class="px-3 text-[11px] font-extrabold text-slate-400 uppercase tracking-wider mb-2">Utilitas Administrator</div>
      <nav class="space-y-1">
        <a href="/admin/dashboard" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/admin/dashboard' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-chart-line w-6 text-indigo-500"></i> Dashboard Real-Time
        </a>
        <a href="/admin/classes" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/admin/classes' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-school w-6 text-indigo-500"></i> Data Kelas
        </a>
        <a href="/admin/students" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/admin/students' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-users w-6 text-indigo-500"></i> Data Siswa
        </a>
        <a href="/admin/teachers" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/admin/teachers' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-user-tie w-6 text-indigo-500"></i> Data Guru Mapel
        </a>
        <a href="/admin/subjects" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/admin/subjects' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-book-open w-6 text-indigo-500"></i> Mata Pelajaran
        </a>
        <a href="/admin/schedules" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/admin/schedules' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-regular fa-calendar-days w-6 text-indigo-500"></i> Jadwal Mengajar
        </a>
        <a href="/admin/audit" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/admin/audit' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-file-shield w-6 text-indigo-500"></i> Log Audit Presensi
        </a>
      </nav>
    </div>
    <% } %>

    <% if (user && user.role === 'GURU_MAPEL') { %>
    <div>
      <div class="px-3 text-[11px] font-extrabold text-slate-400 uppercase tracking-wider mb-2">Portal Guru Pengajar</div>
      <nav class="space-y-1">
        <a href="/guru/dashboard" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/guru/dashboard' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-house w-6 text-indigo-500"></i> Dashboard Guru
        </a>
        <a href="/guru/verify-notes" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/guru/verify-notes' ? 'bg-amber-50/80 text-amber-700 font-bold border-l-4 border-amber-500 shadow-xs' : '' %>">
          <i class="fa-solid fa-file-signature w-6 text-amber-500"></i> Verifikasi Surat Sakit/Izin
        </a>
        <a href="/guru/monthly-recap" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/guru/monthly-recap' ? 'bg-emerald-50/80 text-emerald-700 font-bold border-l-4 border-emerald-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-print w-6 text-emerald-500"></i> Cetak Rekap Bulanan
        </a>
      </nav>
    </div>
    <% } %>

    <% if (user && user.role === 'SISWA') { %>
    <div>
      <div class="px-3 text-[11px] font-extrabold text-slate-400 uppercase tracking-wider mb-2">Portal Siswa / Orang Tua</div>
      <nav class="space-y-1">
        <a href="/siswa/dashboard" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/siswa/dashboard' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-chart-pie w-6 text-indigo-500"></i> Dashboard Kehadiran
        </a>
        <a href="/siswa/personal-recap" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/siswa/personal-recap' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-list-check w-6 text-indigo-500"></i> Rekapitulasi Presensi
        </a>
        <a href="/siswa/upload-note" class="flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl text-slate-700 hover:bg-slate-100/80 hover:text-indigo-600 transition <%= path === '/siswa/upload-note' ? 'bg-indigo-50/80 text-indigo-600 font-bold border-l-4 border-indigo-600 shadow-xs' : '' %>">
          <i class="fa-solid fa-cloud-arrow-up w-6 text-indigo-500"></i> Upload Surat Dokter/Izin
        </a>
      </nav>
    </div>
    <% } %>

  </div>

  <div class="p-3.5 bg-gradient-to-br from-indigo-50 to-violet-50 border border-indigo-100 rounded-2xl">
    <div class="flex items-center space-x-2 text-indigo-900 text-xs font-bold mb-1">
      <i class="fa-solid fa-shield-halved text-indigo-600"></i>
      <span>Sistem Terverifikasi</span>
    </div>
    <p class="text-[11px] text-indigo-700/80 leading-relaxed font-medium">Presensi Harian & Jurnal Mengajar Terintegrasi UKK 2026.</p>
  </div>
</aside>
